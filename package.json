{
  "name": "siyuan-plugin-browser",
  "version": "0.1.1",
  "description": "A full-featured browser inside SiYuan, powered by Electron <webview>.",
  "main": ".src/index.js",
  "scripts": {
    "dev": "run-p dev:kernel dev:app",
    "dev:app": "webpack --config webpack.config.js --mode development --watch",
    "dev:kernel": "webpack --config webpack.kernel.config.js --mode development --watch",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('.src',{recursive:true,force:true});fs.rmSync('dist',{recursive:true,force:true});\"",
    "build": "run-s clean build:app build:kernel zip",
    "build:app": "webpack --config webpack.config.js --mode production",
    "build:kernel": "webpack --config webpack.kernel.config.js --mode production",
    "zip": "node scripts/zip.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "adm-zip": "^0.6.0",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.4",
    "esbuild-loader": "^4.4.3",
    "mini-css-extract-plugin": "^2.10.2",
    "npm-run-all": "^4.1.5",
    "sass": "^1.83.0",
    "sass-loader": "^17.0.0",
    "siyuan": "1.2.2",
    "typescript": "^5.6.3",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "zip-webpack-plugin": "^4.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.15.0+sha512.266f8957a30d2be6e9468e5e66bcdedd35a794175f71b067ba8504d686cce1d0c0f429b33c323c3c569ad4891e667574a49ff71d1b89a22cc66f13c65818c578"
}
